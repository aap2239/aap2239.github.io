---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Aishwarya Patange" description="That page does not exist.">
  <section class="nf" aria-labelledby="nf-title">
    <div class="container nf__inner">
      <h1 id="nf-title" class="display nf__title">This page went off the map</h1>
      <p class="muted measure">The link may be old, or the page moved. Everything worth seeing is on the home page.</p>
      <a class="btn btn--primary" href="/">Back home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: var(--space-10);
  }
  .nf__inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .nf__title {
    font-size: var(--step-4);
  }
  .nf__title em {
    font-style: normal;
    color: var(--accent);
  }
</style>
