---
import type { Project } from '@/data/types';
import MetricChip from './MetricChip.astro';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const featured = !!p.featured;
const href = p.link?.href ?? p.repo;
const linkLabel = p.link?.label ?? 'View on GitHub';
---

<article class:list={['card', { 'card--featured': featured }]}>
  <div class="card__top">
    <p class="eyebrow">{p.kind}</p>
    <span class="card__year">{p.year}</span>
  </div>

  <h3 class="card__title display">
    {href ? (
      <a href={href} target="_blank" rel="noopener" class="card__link">
        {p.title}<span class="visually-hidden"> (opens in new tab)</span>
      </a>
    ) : (
      p.title
    )}
  </h3>

  {featured ? (
    <dl class="card__story">
      <div><dt>Problem</dt><dd>{p.problem}</dd></div>
      <div><dt>Approach</dt><dd>{p.approach}</dd></div>
      <div><dt>Outcome</dt><dd>{p.outcome}</dd></div>
    </dl>
  ) : (
    <p class="card__desc">{p.description}</p>
  )}

  {p.metrics && p.metrics.length > 0 && (
    <div class="card__metrics">
      {p.metrics.map((m) => <MetricChip metric={m} />)}
    </div>
  )}

  <div class="card__foot">
    <ul class="tags" aria-label="Technologies">
      {p.tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
    {href && (
      <span class="card__cta" aria-hidden="true">{linkLabel} ↗</span>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    background: var(--bg-2);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .card--featured {
    gap: var(--space-5);
  }
  @media (hover: hover) {
    .card:hover {
      border-color: var(--fg);
      background: var(--bg-3);
    }
    .card:hover .card__cta {
      color: var(--accent);
    }
  }
  .card:focus-within {
    border-color: var(--accent);
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  .card__year {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-faint);
    white-space: nowrap;
  }
  .card__title {
    font-size: var(--step-1);
    line-height: 1;
  }
  .card--featured .card__title {
    font-size: var(--step-2);
  }
  /* The whole card is clickable via the title link's ::after. */
  .card__link {
    text-decoration: none;
    color: var(--fg);
  }
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card__desc {
    color: var(--fg-muted);
    flex: 1;
  }
  .card__story {
    display: grid;
    gap: var(--space-4);
  }
  .card__story div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-3);
  }
  .card__story dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 0.35em;
  }
  .card__story dd {
    color: var(--fg-muted);
  }
  @media (max-width: 480px) {
    .card__story div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
  .card__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
    padding-top: var(--space-2);
  }
  .card__foot {
    display: grid;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-2);
  }
  .card__cta {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }
</style>
