---
/**
 * Section wrapper: consistent padding, numbered eyebrow, accessible heading.
 * Pass `title` with `<em>` inside via the `titleHtml` prop for the accent word.
 */
interface Props {
  id: string;
  number: string;
  eyebrow: string;
  titleHtml: string;
  class?: string;
}
const { id, number, eyebrow, titleHtml, class: className } = Astro.props;
---

<section id={id} class:list={['chapter', className]} aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="chapter__head" data-reveal>
      <p class="eyebrow"><b>{number}</b> — {eyebrow}</p>
      <h2 id={`${id}-title`} class="chapter__title" set:html={titleHtml} />
    </header>
    <slot />
  </div>
</section>
