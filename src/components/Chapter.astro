---
/**
 * Section wrapper: consistent padding and an accessible heading.
 * No number, no eyebrow — the heading carries the section on its own.
 */
interface Props {
  id: string;
  title: string;
  class?: string;
}
const { id, title, class: className } = Astro.props;
---

<section id={id} class:list={['chapter', className]} aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="chapter__head" data-reveal>
      <h2 id={`${id}-title`} class="chapter__title">{title}</h2>
    </header>
    <slot />
  </div>
</section>
