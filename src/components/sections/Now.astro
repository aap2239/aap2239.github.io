---
import Chapter from '@/components/Chapter.astro';
import { now, nowUpdated } from '@/data/now';
---

<Chapter id="now" number="07" eyebrow="Now" titleHtml="What I’m <em>up to</em> lately.">
  <div class="now">
    <dl class="now__list" data-reveal-group>
      {now.map((item) => (
        <div class:list={['now__item', { 'is-todo': item.todo }]}>
          <dt class="eyebrow">{item.label}</dt>
          <dd>
            <span class="now__value">{item.value}</span>
            {item.detail && <span class="now__detail muted">{item.detail}</span>}
          </dd>
        </div>
      ))}
    </dl>
    <p class="now__stamp eyebrow" data-reveal data-stamp>Updated {nowUpdated}</p>
  </div>
</Chapter>

<style>
  .now {
    display: grid;
    gap: var(--space-6);
  }
  .now__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-8);
  }
  .now__item {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .now__item dd {
    display: grid;
    gap: var(--space-1);
  }
  .now__value {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .now__detail {
    font-size: var(--step--1);
  }
  .now__item.is-todo .now__value {
    outline: 1px dashed var(--accent);
    outline-offset: 6px;
    border-radius: 2px;
  }
  .now__stamp {
    justify-self: start;
    padding: 0.5em 0.9em;
    border: 1px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    transform: rotate(-2deg);
  }
  @media (max-width: 640px) {
    .now__list {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
