---
import Chapter from '@/components/Chapter.astro';
import MetricChip from '@/components/MetricChip.astro';
import { site } from '@/data/site';
const { about } = site;
---

<Chapter
  id="about"
  number="01"
  eyebrow="Story"
  titleHtml="Five years of turning <em>messy data</em> into things people use."
>
  <div class="about">
    <div class="about__lead-col">
      <p class="about__lead display" data-reveal>{about.lead}</p>
      <ul class="about__stats" data-reveal-group aria-label="At a glance">
        {about.stats.map((s) => (
          <li><MetricChip metric={s} size="lg" /></li>
        ))}
      </ul>
    </div>

    <div class="about__text">
      {about.paragraphs.map((p) => <p class="muted" data-reveal>{p}</p>)}
    </div>
  </div>
</Chapter>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .about__lead-col {
    display: grid;
    gap: var(--space-7);
  }
  .about__lead {
    font-size: var(--step-2);
    line-height: 1.05;
    max-width: 22ch;
  }
  .about__text {
    display: grid;
    gap: var(--space-5);
    font-size: var(--step-1);
    padding-top: 0.35em;
  }
  .about__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .about__stats li {
    padding: var(--space-5) var(--space-4);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 767px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__text {
      font-size: var(--step-0);
    }
  }
  @media (max-width: 480px) {
    .about__stats {
      grid-template-columns: 1fr 1fr;
    }
    .about__stats li:last-child:nth-child(odd) {
      grid-column: span 2;
    }
  }
</style>
