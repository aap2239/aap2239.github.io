---
import { Picture } from 'astro:assets';
import headshot from '@/assets/headshot.jpg';
import Chapter from '@/components/Chapter.astro';
import MetricChip from '@/components/MetricChip.astro';
import { site } from '@/data/site';
const { about } = site;
---

<Chapter
  id="about"
  number="01"
  eyebrow="Story"
  titleHtml="Five years of turning <em>messy data</em> into things people use."
>
  <div class="about">
    <figure class="about__figure" data-reveal="clip">
      <Picture
        src={headshot}
        formats={['avif', 'webp']}
        width={720}
        height={720}
        widths={[320, 480, 640, 840]}
        sizes="(min-width: 768px) 420px, 260px"
        alt="Aishwarya Patange"
        loading="lazy"
        decoding="async"
        pictureAttributes={{ class: 'about__picture' }}
      />
      <figcaption class="eyebrow">Stamford, CT · by way of Mumbai</figcaption>
    </figure>

    <div class="about__text">
      <p class="about__lead" data-reveal>{about.lead}</p>
      {about.paragraphs.map((p) => <p class="muted" data-reveal>{p}</p>)}

      <ul class="about__stats" data-reveal-group aria-label="At a glance">
        {about.stats.map((s) => (
          <li><MetricChip metric={s} size="lg" /></li>
        ))}
      </ul>
    </div>
  </div>
</Chapter>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .about__figure {
    display: grid;
    gap: var(--space-3);
    max-width: 420px;
  }
  .about__figure :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius-lg);
    outline: 1px solid var(--line);
    outline-offset: -1px;
    filter: saturate(0.9) contrast(1.02);
  }
  .about__text {
    display: grid;
    gap: var(--space-5);
  }
  .about__lead {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .about__stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: var(--space-5) var(--space-8);
    margin-top: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 767px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__figure {
      max-width: 260px;
    }
    .about__stats {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4) var(--space-6);
    }
  }
</style>
