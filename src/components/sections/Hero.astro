---
import { Picture } from 'astro:assets';
import headshot from '@/assets/headshot.jpg';
import MetricChip from '@/components/MetricChip.astro';
import { site } from '@/data/site';
const { hero } = site;
---

<section id="top" class="hero" aria-label="Introduction">
  <div class="container hero__inner" data-hero>
    <div class="hero__text">
      <p class="eyebrow eyebrow--dash hero__eyebrow" data-intro>{hero.eyebrow}</p>

      <h1 class="hero__title display">
        {hero.lines.map((line, i) => (
          <span class="mask-line">
            <span class:list={{ 'hero__accent': i === hero.accentLine }}>{line}</span>
          </span>
        ))}
      </h1>

      <p class="hero__sub" data-intro>{hero.sub}</p>

      <div class="hero__cta" data-intro>
        <a class="btn btn--primary" href="#work">
          See the work
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="btn" href="#contact">Say hello</a>
      </div>

      <p class="hero__status eyebrow" data-intro>
        <span class="hero__dot" aria-hidden="true"></span>{hero.status}
      </p>
    </div>

    <div class="hero__side" data-intro>
      <figure class="hero__portrait">
        <Picture
          src={headshot}
          formats={['avif', 'webp']}
          width={720}
          height={720}
          widths={[320, 480, 640, 840]}
          sizes="(min-width: 900px) 400px, 260px"
          alt="Aishwarya Patange"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <span class="hero__halftone" aria-hidden="true"></span>
        <figcaption class="visually-hidden">Portrait of Aishwarya Patange</figcaption>
      </figure>
      <ul class="hero__metrics" aria-label="Selected results">
        {hero.metrics.map((m) => (
          <li><MetricChip metric={m} /></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="hero__strip" aria-hidden="true">
    <div class="container hero__strip-inner">
      {hero.strip.map((item, i) => (
        <>
          {i > 0 && <span class="hero__strip-dot">·</span>}
          <span>{item}</span>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(56px + var(--space-8));
    overflow: clip;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    width: min(100% - 2 * var(--gutter), var(--container));
    padding-bottom: var(--space-8);
  }
  .hero__text {
    display: grid;
    gap: var(--space-6);
  }
  .hero__title {
    font-size: var(--step-5);
    display: grid;
  }
  .mask-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }
  .mask-line > span {
    display: block;
    will-change: transform;
  }
  .hero__accent {
    color: var(--accent);
  }
  .hero__sub {
    max-width: 52ch;
    font-size: var(--step-1);
    color: var(--fg-muted);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero__status {
    margin-top: var(--space-4);
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
  }

  .hero__side {
    display: grid;
    gap: var(--space-5);
    max-width: 400px;
    justify-self: end;
    width: 100%;
  }
  .hero__portrait {
    position: relative;
    overflow: hidden;
    background: var(--bg-3);
  }
  .hero__portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    object-position: center 18%;
    filter: grayscale(1) contrast(1.15) brightness(0.95);
  }
  .hero__halftone {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(180deg, transparent 55%, var(--bg) 100%),
      radial-gradient(rgb(16 16 16 / 0.55) 1.1px, transparent 1.4px);
    background-size: 100% 100%, 5px 5px;
  }
  .hero__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .hero__metrics li {
    padding: var(--space-4) var(--space-4);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .hero__strip {
    border-top: 1px solid var(--line);
    padding-block: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--fg);
    overflow: hidden;
  }
  .hero__strip-inner {
    display: flex;
    gap: var(--space-5);
    white-space: nowrap;
  }
  .hero__strip-dot {
    color: var(--accent);
  }

  @media (max-width: 899px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__side {
      justify-self: start;
      max-width: 100%;
      grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
      align-items: end;
    }
  }
  @media (max-width: 560px) {
    .hero__side {
      grid-template-columns: 1fr;
    }
    .hero__portrait {
      max-width: 260px;
    }
  }
</style>
