---
import { site, socials } from '@/data/site';
const { hero } = site;
---

<section id="top" class="hero" aria-label="Introduction">
  <div class="hero__bg" aria-hidden="true">
    <div class="glow hero__glow-1" data-glow></div>
    <div class="glow glow--2 hero__glow-2"></div>
  </div>

  <div class="container hero__inner" data-hero>
    <p class="eyebrow hero__eyebrow" data-intro>{hero.eyebrow}</p>

    <h1 class="hero__title display">
      {hero.lines.map((line, i) => (
        <span class="mask-line">
          <span class:list={{ 'hero__accent': i === hero.accentLine }}>{line}</span>
        </span>
      ))}
    </h1>

    <p class="hero__sub" data-intro>{hero.sub}</p>

    <div class="hero__cta" data-intro>
      <a class="btn btn--primary" href="#work">
        See the work
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="btn" href={site.resumePath} target="_blank" rel="noopener">
        Resume<span class="visually-hidden"> (PDF, opens in new tab)</span>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="hero__foot" data-intro>
      <span class="hero__scroll eyebrow" aria-hidden="true">
        Scroll<span class="hero__scroll-line"></span>
      </span>
      <ul class="hero__socials" aria-label="Profiles">
        {socials.slice(0, 3).map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener me">
              {s.label}<span class="visually-hidden"> (opens in new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(56px + var(--space-8)) var(--space-8);
    overflow: clip;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .hero__glow-1 {
    top: -20vmax;
    right: -15vmax;
  }
  .hero__glow-2 {
    bottom: -30vmax;
    left: -20vmax;
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    .hero__glow-2 {
      animation: drift 18s ease-in-out infinite alternate;
    }
    @keyframes drift {
      from { transform: translate3d(0, 0, 0); }
      to { transform: translate3d(40px, -30px, 0); }
    }
  }
  .hero__inner {
    display: grid;
    gap: var(--space-6);
    width: min(100% - 2 * var(--gutter), var(--container));
  }
  .hero__eyebrow {
    color: var(--fg-muted);
  }
  .hero__title {
    font-size: var(--step-5);
    line-height: 0.95;
    display: grid;
  }
  .mask-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .mask-line > span {
    display: block;
    will-change: transform;
  }
  .hero__accent {
    font-style: italic;
    color: var(--accent);
  }
  .hero__sub {
    max-width: 52ch;
    font-size: var(--step-1);
    color: var(--fg-muted);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }
  .hero__scroll-line {
    display: inline-block;
    width: 56px;
    height: 1px;
    background: var(--fg-faint);
  }
  .hero__socials {
    display: flex;
    gap: var(--space-4);
  }
  .hero__socials a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--step--1);
    color: var(--fg-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hero__socials a:hover {
    color: var(--accent);
  }
  @media (max-width: 480px) {
    .hero__foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
