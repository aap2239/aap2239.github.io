---
import Chapter from '@/components/Chapter.astro';
import MetricChip from '@/components/MetricChip.astro';
import { experience } from '@/data/experience';

/** The scrubbing year starts at the present and counts back through the roles. */
const startYear = String(new Date().getFullYear());
---

<Chapter id="experience" title="Where the work happened">
  <div class="xp" data-xp>
    <div class="xp__side">
      <div class="xp__sticky" aria-hidden="true">
        <span class="xp__year display" data-xp-year>{startYear}</span>
        <div class="xp__metas">
          {experience.map((e, i) => (
            <div class="xp__meta" data-xp-meta={i}>
              <span class="xp__company">{e.company}</span>
              <span class="xp__role muted">{e.role}</span>
              <span class="xp__dates label">{e.start} – {e.end}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <ol class="xp__list">
      {experience.map((e, i) => (
        <li class:list={['xp__card', { 'is-todo': e.todo }]} data-xp-card={i} data-xp-year={e.year} data-reveal>
          <header class="xp__head">
            <p class="label">
              {e.start} – {e.end} · {e.location}
            </p>
            <h3 class="xp__title display">
              {e.role}{' '}
              <span class="xp__at">
                at{' '}
                {e.href ? (
                  <a href={e.href} target="_blank" rel="noopener">{e.company}<span class="visually-hidden"> (opens in new tab)</span></a>
                ) : (
                  e.company
                )}
              </span>
            </h3>
            <p class="muted">{e.summary}</p>
          </header>

          <ul class="xp__bullets">
            {e.bullets.map((b) => <li>{b}</li>)}
          </ul>

          {e.metrics.length > 0 && (
            <div class="xp__metrics">
              {e.metrics.map((m) => <MetricChip metric={m} />)}
            </div>
          )}

          <p class="toolline">{e.tags.join(', ')}</p>
        </li>
      ))}
    </ol>
  </div>
</Chapter>

<style>
  .xp {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .xp__side {
    /* The grid is align-items: start, which would size this column to its own
       content and let the sticky block scroll away after a few hundred pixels.
       Stretching it to the row height lets the year travel the whole section. */
    align-self: stretch;
  }
  .xp__sticky {
    position: sticky;
    top: 22vh;
    min-height: 16rem;
  }
  .xp__metas {
    position: relative;
    min-height: 7rem;
  }
  .xp__meta {
    position: absolute;
    inset: 0 auto auto 0;
    display: grid;
    gap: var(--space-1);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }
  .xp__meta[data-active],
  :global(html:not(.js)) .xp__meta:first-child {
    opacity: 1;
    transform: none;
  }
  .xp__year {
    display: block;
    font-size: var(--step-4);
    color: var(--accent);
    line-height: 1;
    margin-bottom: var(--space-3);
    /* Keeps the box from jittering as the digits scrub. */
    font-variant-numeric: tabular-nums;
  }
  .xp__company {
    font-size: var(--step-1);
    font-weight: 600;
  }
  .xp__list {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
  }
  .xp__card {
    display: grid;
    gap: var(--space-5);
    /* no border: cards group by spacing */
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  /* Unfinished entries stay visibly unfinished, in the palette. */
  .xp__card.is-todo {
    outline: 1px dashed var(--accent);
    outline-offset: var(--space-4);
  }
  .xp__head {
    display: grid;
    gap: var(--space-2);
  }
  .xp__title {
    font-size: var(--step-1);
    line-height: 1.05;
  }
  .xp__at {
    color: var(--fg-muted);
  }
  .xp__at a {
    color: var(--fg);
    text-decoration-color: var(--accent);
  }
  .xp__bullets {
    display: grid;
    gap: var(--space-3);
  }
  .xp__bullets li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--fg-muted);
  }
  .xp__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 6px;
    background: var(--accent);
  }
  .xp__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
    padding-top: var(--space-2);
  }
  @media (max-width: 767px) {
    .xp {
      grid-template-columns: 1fr;
    }
    .xp__side {
      display: none;
    }
  }
</style>
