---
import Chapter from '@/components/Chapter.astro';
import { skillStages } from '@/data/skills';
---

<Chapter id="skills" title="The pipeline I ship with">
  <p class="skills__intro muted measure" data-reveal>
    No proficiency bars. These are the tools behind the work above, grouped the way a project actually
    flows. The ones in white have shipped in something on this page.
  </p>

  <div class="pipe" data-pipe>
    {skillStages.map((stage, i) => (
      <div class="pipe__stage" data-reveal-group>
        <h3 class="pipe__name display">{stage.name}</h3>
        <p class="pipe__blurb muted">{stage.blurb}</p>
        <ul class="pipe__skills" aria-label={`${stage.name} tools`}>
          {stage.skills.map((s) => (
            <li class:list={{ 'is-used': !!s.usedIn }}>
              {s.name}
              {s.usedIn && <span class="visually-hidden"> (used in {s.usedIn})</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Chapter>

<style>
  .skills__intro {
    margin-top: calc(-1 * var(--space-6));
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  @media (max-width: 767px) {
    .skills__intro {
      margin-top: calc(-1 * var(--space-3));
    }
  }
  .pipe {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    padding-top: var(--space-6);
  }
  .pipe__stage {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .pipe__name {
    font-size: var(--step-1);
  }
  .pipe__blurb {
    font-size: var(--step--1);
    min-height: 2.6em;
  }
  .pipe__skills {
    display: grid;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  /* Tools she has actually shipped with read in full strength; the rest sit back. */
  .pipe__skills .is-used {
    color: var(--fg);
  }
  @media (max-width: 1023px) {
    .pipe {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .pipe {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .pipe__blurb {
      min-height: 0;
    }
  }
</style>
