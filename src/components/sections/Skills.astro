---
import Chapter from '@/components/Chapter.astro';
import { skillStages } from '@/data/skills';
---

<Chapter id="skills" number="05" eyebrow="Toolbox" titleHtml="The pipeline I <em>ship</em> with.">
  <p class="skills__intro muted measure" data-reveal>
    No proficiency bars. These are the tools behind the work above, grouped the way a project actually flows.
    Anything with an amber dot has shipped in something on this page.
  </p>

  <div class="pipe" data-pipe>
    <span class="pipe__line" aria-hidden="true"><span data-pipe-line></span></span>
    {skillStages.map((stage, i) => (
      <div class="pipe__stage" data-reveal-group>
        <h3 class="pipe__name">
          <span class="pipe__idx" aria-hidden="true">0{i + 1}</span>
          {stage.name}
        </h3>
        <p class="pipe__blurb muted">{stage.blurb}</p>
        <ul class="tags" aria-label={`${stage.name} tools`}>
          {stage.skills.map((s) => (
            <li class:list={['tag', { 'tag--used': !!s.usedIn }]}>
              {s.name}
              {s.usedIn && <span class="visually-hidden"> (used in {s.usedIn})</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Chapter>

<style>
  .skills__intro {
    margin-top: calc(-1 * var(--space-6));
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  @media (max-width: 767px) {
    .skills__intro {
      margin-top: calc(-1 * var(--space-3));
    }
  }
  .pipe {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    padding-top: var(--space-6);
  }
  .pipe__line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line-strong);
  }
  .pipe__line > span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
  }
  .pipe__stage {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .pipe__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step-2);
  }
  .pipe__idx {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    letter-spacing: var(--tracking-mono);
  }
  .pipe__blurb {
    font-size: var(--step--1);
    min-height: 2.6em;
  }
  .tag--used {
    color: var(--fg);
    border-color: var(--line-strong);
    padding-left: 1.5em;
    position: relative;
  }
  .tag--used::before {
    content: '';
    position: absolute;
    left: 0.65em;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-50%);
  }
  @media (max-width: 1023px) {
    .pipe {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .pipe {
      grid-template-columns: 1fr;
      padding-top: 0;
      padding-left: var(--space-6);
      gap: var(--space-7);
    }
    .pipe__line {
      top: 0.5rem;
      bottom: 0.5rem;
      right: auto;
      width: 1px;
      height: auto;
    }
    .pipe__line > span {
      transform-origin: top;
    }
    .pipe__blurb {
      min-height: 0;
    }
  }
</style>
