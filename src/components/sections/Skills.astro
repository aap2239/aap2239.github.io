---
import Chapter from '@/components/Chapter.astro';
import { skillStages } from '@/data/skills';
---

<Chapter id="skills" title="The pipeline I ship with">
  <p class="skills__intro muted measure" data-reveal>
    No proficiency bars. These are the tools behind the work above, grouped the way a project actually
    flows. Anything with a red mark has shipped in something on this page.
  </p>

  <div class="pipe" data-pipe>
    {skillStages.map((stage) => (
      <div class="pipe__stage" data-reveal-group>
        <h3 class="pipe__name display">{stage.name}</h3>
        <p class="pipe__blurb muted">{stage.blurb}</p>
        <ul class="pipe__skills" aria-label={`${stage.name} tools`}>
          {stage.skills.map((s) => (
            <li class:list={{ 'is-used': !!s.usedIn }}>
              {s.name}
              {s.usedIn && <span class="visually-hidden"> (used in {s.usedIn})</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Chapter>

<style>
  .skills__intro {
    margin-top: calc(-1 * var(--space-6));
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  @media (max-width: 767px) {
    .skills__intro {
      margin-top: calc(-1 * var(--space-3));
    }
  }
  .pipe {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    padding-top: var(--space-6);
  }
  .pipe__stage {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .pipe__name {
    font-size: var(--step-1);
  }
  .pipe__blurb {
    font-size: var(--step--1);
    min-height: 2.6em;
  }
  /* Pills are a deliberate exception to the no-chips rule, and live only here:
     a stage is a set of interchangeable tools, so they read better as a cloud
     than as a list. Sentence case and body font, not mono caps. */
  .pipe__skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .pipe__skills li {
    display: inline-block;
    padding: 0.35em 0.7em;
    border: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--fg-muted);
    white-space: nowrap;
  }
  /* The red mark flags a tool she has actually shipped with. */
  .pipe__skills .is-used {
    position: relative;
    padding-left: 1.5em;
    color: var(--fg);
  }
  .pipe__skills .is-used::before {
    content: '';
    position: absolute;
    left: 0.65em;
    top: 50%;
    width: 6px;
    height: 6px;
    background: var(--accent);
    transform: translateY(-50%);
  }
  @media (max-width: 1023px) {
    .pipe {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .pipe {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .pipe__blurb {
      min-height: 0;
    }
  }
</style>
