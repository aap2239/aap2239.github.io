---
/**
 * Abstract route through the journey stops. Desktop only (hidden under 768px;
 * the mobile layout uses a CSS timeline instead). Route geometry is a
 * Catmull-Rom spline converted to cubic Béziers so any number of stops works.
 */
import { journey } from '@/data/journey';

const W = 1200;
const H = 520;

type P = { x: number; y: number };
function spline(pts: P[], tension = 0.5): string {
  if (pts.length < 2) return '';
  const d = [`M${pts[0].x},${pts[0].y}`];
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1.x + ((p2.x - p0.x) / 6) * tension * 2;
    const c1y = p1.y + ((p2.y - p0.y) / 6) * tension * 2;
    const c2x = p2.x - ((p3.x - p1.x) / 6) * tension * 2;
    const c2y = p2.y - ((p3.y - p1.y) / 6) * tension * 2;
    d.push(`C${c1x.toFixed(1)},${c1y.toFixed(1)} ${c2x.toFixed(1)},${c2y.toFixed(1)} ${p2.x},${p2.y}`);
  }
  return d.join(' ');
}

const path = spline(journey);
const gridX = Array.from({ length: 11 }, (_, i) => (i * W) / 10);
const gridY = Array.from({ length: 5 }, (_, i) => (i * H) / 4);
---

<svg
  class="map"
  viewBox={`0 0 ${W} ${H}`}
  width={W}
  height={H}
  role="img"
  aria-labelledby="map-title"
  data-map
>
  <title id="map-title">Route from Mumbai to Bangalore to New York to Stamford</title>

  <g class="map__grid" aria-hidden="true">
    {gridX.map((x) => <line x1={x} y1="0" x2={x} y2={H} />)}
    {gridY.map((y) => <line x1="0" y1={y} x2={W} y2={y} />)}
  </g>

  <path class="map__ghost" d={path} aria-hidden="true" />
  <path class="map__route" d={path} data-route aria-hidden="true" />

  <g aria-hidden="true">
    {journey.map((s, i) => (
      <g class="map__stop" data-stop={i}>
        <circle class="map__ring" cx={s.x} cy={s.y} r="14" data-marker />
        <circle class="map__dot" cx={s.x} cy={s.y} r="5" data-marker />
        <text
          class="map__label"
          x={s.x}
          y={s.y + (s.y > H / 2 ? 44 : -34)}
          text-anchor="middle"
        >
          {s.city}
        </text>
        <text
          class="map__years"
          x={s.x}
          y={s.y + (s.y > H / 2 ? 66 : -64)}
          text-anchor="middle"
        >
          {s.years}
        </text>
      </g>
    ))}
  </g>

  <g class="map__traveller" data-traveller aria-hidden="true">
    <circle r="16" class="map__halo" />
    <circle r="6" class="map__ship" />
  </g>
</svg>

<style>
  .map {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .map__grid line {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .map__ghost {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-dasharray: 2 8;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .map__route {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .map__ring {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .map__dot {
    fill: var(--accent);
  }
  [data-marker] {
    transform-box: fill-box;
    transform-origin: center;
  }
  .map__label {
    fill: var(--fg);
    font-family: var(--font-display);
    font-size: 30px;
    letter-spacing: -0.01em;
  }
  .map__years {
    fill: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
  }
  .map__traveller {
    will-change: transform;
  }
  .map__halo {
    fill: var(--accent);
    opacity: 0.18;
  }
  .map__ship {
    fill: var(--fg);
    stroke: var(--accent);
    stroke-width: 3;
  }
  /* Without JS (or with reduced motion) the route is fully drawn and the traveller sits at the end. */
  html:not(.js) .map__traveller,
  html:not(.js) [data-marker] {
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .map__traveller {
      display: none;
    }
  }
</style>
