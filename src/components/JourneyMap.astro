---
/**
 * World map with the journey route. Built at build time from Natural Earth data.
 * The default viewBox is the whole world, so without JavaScript (or under reduced
 * motion) the full route and every stop are visible. On desktop, journey.ts flies
 * the camera by animating the viewBox as the page scrolls.
 */
import { journey, camera, pacing } from '@/data/journey';
import {
  MAP_W,
  MAP_H,
  project,
  worldLandPath,
  detailLandPath,
  graticulePath,
  arcPath,
} from '@/lib/worldmap';

const ASPECT = 2.1;
const world = worldLandPath();
// Extra coastline detail where the camera zooms in: India, and the US Northeast.
const detail = detailLandPath([
  [[52, -2], [100, 36]],
  [[-100, 24], [-56, 56]],
]);
const graticule = graticulePath(30);

const stops = journey.map((s) => ({ ...s, ...project(s.lon, s.lat) }));
const segments = stops.slice(1).map((b, i) => arcPath(stops[i], b));

// Schedule: when the dot arrives at and departs from each stop.
const arrive: number[] = [0];
const depart: number[] = [];
stops.forEach((_, i) => {
  depart[i] = arrive[i] + pacing.hold;
  if (i < pacing.legs.length) arrive[i + 1] = depart[i] + pacing.legs[i];
});
const last = stops.length - 1;
const worldEnd = depart[last] + pacing.world;
const total = worldEnd + pacing.tail;

// Camera keyframes in map units, with a matching key at departure so the camera rests during holds.
const cam: Array<{ t: number; x: number; y: number; w: number }> = [];
for (const k of camera) {
  const w = +((k.w / 360) * MAP_W).toFixed(1);
  if (k.at === 'world') {
    const c = project(0, 0);
    cam.push({ t: worldEnd, x: c.x, y: c.y, w });
  } else if (k.at === 'mid') {
    const c = project(k.lon, k.lat);
    cam.push({ t: depart[k.i] + pacing.legs[k.i] / 2, x: +c.x.toFixed(1), y: +c.y.toFixed(1), w });
  } else {
    const s = stops[k.i];
    const c = project(k.lon ?? s.lon, k.lat ?? s.lat);
    cam.push({ t: arrive[k.i], x: +c.x.toFixed(1), y: +c.y.toFixed(1), w });
    cam.push({ t: depart[k.i], x: +c.x.toFixed(1), y: +c.y.toFixed(1), w });
  }
}
cam.sort((a, b) => a.t - b.t);

const schedule = { arrive, depart, legs: pacing.legs, worldEnd, total, scrollPerUnit: pacing.scrollPerUnit };

// Label placement relative to the marker (in map units at world zoom; counter-scaled by JS).
function labelPos(side: string) {
  switch (side) {
    case 'above': return { x: 0, y: -26, anchor: 'middle', yearsY: -46 };
    case 'left': return { x: -22, y: 8, anchor: 'end', yearsY: 26 };
    case 'right': return { x: 22, y: 8, anchor: 'start', yearsY: 26 };
    default: return { x: 0, y: 40, anchor: 'middle', yearsY: 60 };
  }
}
const defaultView = `0 ${(MAP_H - MAP_W / ASPECT) / 2} ${MAP_W} ${MAP_W / ASPECT}`;
---

<svg
  class="map"
  viewBox={defaultView}
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-labelledby="map-title"
  data-map
  data-camera={JSON.stringify(cam)}
  data-schedule={JSON.stringify(schedule)}
  data-aspect={ASPECT}
  data-world-w={MAP_W}
>
  <title id="map-title">World map showing the route from Mumbai to Bangalore to New York, with Stamford as the current office</title>

  <rect x="0" y="0" width={MAP_W} height={MAP_H} class="map__ocean" />
  <path class="map__graticule" d={graticule} aria-hidden="true" />
  <path class="map__land" d={world} aria-hidden="true" />
  <path class="map__land" d={detail} aria-hidden="true" />

  <g aria-hidden="true">
    {segments.map((d, i) => (
      <>
        <path class="map__ghost" d={d} />
        <path class="map__route" d={d} data-seg={i} />
      </>
    ))}
  </g>

  <g aria-hidden="true">
    {stops.map((s, i) => {
      const lp = labelPos(s.label);
      return (
        <g class="map__stop" data-stop={i} data-x={s.x.toFixed(1)} data-y={s.y.toFixed(1)} transform={`translate(${s.x.toFixed(1)} ${s.y.toFixed(1)})`}>
          <g data-pop>
            <circle class="map__ring" r="14" />
            <circle class="map__dot" r="5" />
          </g>
          <g data-label>
            <text class="map__label" x={lp.x} y={lp.y} text-anchor={lp.anchor}>{s.city}</text>
            <text class="map__years" x={lp.x} y={lp.yearsY} text-anchor={lp.anchor}>{s.years}</text>
          </g>
        </g>
      );
    })}
  </g>

  <g class="map__traveller" data-traveller aria-hidden="true">
    <g data-traveller-inner>
      <circle r="16" class="map__halo" />
      <circle r="6" class="map__ship" />
    </g>
  </g>
</svg>

<style>
  .map {
    width: 100%;
    height: auto;
    aspect-ratio: 2.1 / 1;
    display: block;
    background: var(--bg);

  }
  .map__ocean {
    fill: var(--bg);
  }
  .map__graticule {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .map__land {
    fill: #262626;
    stroke: none;
  }
  /* Route strokes are in map units and rescaled by JS as the camera zooms
     (non-scaling-stroke would break dash-based drawing under a moving viewBox). */
  .map__ghost {
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 3;
    stroke-dasharray: 4 12;
    stroke-linecap: round;
    opacity: 0.7;
  }
  .map__route {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .map__ring {
    fill: transparent;
    stroke: var(--accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .map__dot {
    fill: var(--accent);
  }
  .map__label {
    fill: var(--fg);
    font-family: var(--font-display);
    font-size: 22px;
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 6px;
    stroke-linejoin: round;
  }
  .map__years {
    fill: var(--fg-muted);
    font-size: 12px;
    letter-spacing: 0.08em;
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .map__traveller {
    will-change: transform;
  }
  .map__halo {
    fill: var(--accent);
    opacity: 0.2;
  }
  .map__ship {
    fill: var(--fg);
    stroke: var(--accent);
    stroke-width: 3;
  }
  /* Static view (no JS, reduced motion, or mobile): no traveller, labels only for the endpoints. */
  html:not(.js) .map__traveller,
  html:not(.js) [data-stop='1'] [data-label],
  html:not(.js) [data-stop='3'] [data-label] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .map__traveller,
    [data-stop='1'] [data-label],
    [data-stop='3'] [data-label] {
      display: none;
    }
  }
</style>
