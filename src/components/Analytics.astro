---
/**
 * Google Analytics 4. Loads only in production builds and only once an ID is
 * set, so `npm run dev` never pollutes the reports with your own traffic.
 *
 * The ID lives in src/data/site.ts. It is a Measurement ID (G-XXXXXXXXXX), not
 * a secret: it ships in the page source of every GA site on the web, so it is
 * fine in the repo. Do not put an API key or a service-account credential here.
 */
import { site } from '@/data/site';

const id = site.gaId;
const enabled = import.meta.env.PROD && !!id;
---

{
  enabled && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', id, { anonymize_ip: true });
      </script>
    </>
  )
}
